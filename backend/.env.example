# Copy this file to .env and fill in your real values.
# Never commit .env - it contains your Jira API token.

# --- Jira (read by the mcp-atlassian MCP server) ---
# Your Jira Cloud site, e.g. https://your-company.atlassian.net
JIRA_URL=https://your-company.atlassian.net
# The email address you log in to Jira with
JIRA_USERNAME=you@example.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# Default Jira project the app works with (use a test project for the demo)
JIRA_PROJECT_KEY=DEMO

# --- Ollama ---
# The local model used for chat; it must support tool calling
OLLAMA_MODEL=qwen3:8b
